{
    "compilerOptions": {
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "types": ["node", "jest"],
        "target": "es5",
        "ignoreDeprecations": "6.0",
        "lib": ["es2015", "dom"],
        "sourceMap": true,
        "outDir": "dist/lib",
        "declaration": true,
        "declarationDir": "dist/types",
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
